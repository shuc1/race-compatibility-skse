{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/shuc1/race-compatibility-skse/main/res/schema/schema",
    "title": "Race Compatibility SKSE Configuration Schema",
    "description": "Provides definitions for Race Compatibility SKSE(RCS) configuration",
    "$defs": {
        "form": {
            "type": "string",
            "pattern": "^[\\w\\-\\. ]+\\.es[lmp]\\|(0[xX])?[\\da-fA-F]{1,8}$|^[\\w ]+$"
        },
        "armor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "race": {
                    "$ref": "#/$defs/form",
                    "description": "The form of default race for armor addon"
                },
                "variants": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "slots",
                            "proxy"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "slots": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "integer",
                                    "minimum": 30,
                                    "maximum": 61
                                },
                                "description": "The specific armor slots used for armor addon variant"
                            },
                            "proxy": {
                                "$ref": "#/$defs/form",
                                "description": "The form of proxy race for specific slot"
                            }
                        }
                    }
                }
            }
        },
        "race": {
            "type": "object",
            "required": [
                "form"
            ],
            "oneOf": [
                {
                    "required": [
                        "proxy"
                    ]
                },
                {
                    "required": [
                        "proxies"
                    ]
                }
            ],
            "additionalProperties": false,
            "properties": {
                "form": {
                    "$ref": "#/$defs/form",
                    "description": "The form of mortal race"
                },
                "proxy": {
                    "$ref": "#/$defs/form",
                    "description": "The single proxy race used in dialogue, magic effects and Papyrus GetRace. Mutually exclusive with proxies."
                },
                "proxies": {
                    "deprecated": true,
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/form"
                    },
                    "description": "Legacy proxy list. Only the first item is used, even if it cannot be resolved; remaining items are ignored. Emits a deprecation warning. Use proxy instead."
                },
                "armor": {
                    "$ref": "#/$defs/armor"
                }
            }
        },
        "headPartType": {
            "type": "string",
            "description": "The head part preset for injecting race into FormID lists",
            "enum": [
                "Elf",
                "Human",
                "Orc",
                "Argonian",
                "Khajiit",
                "Breton",
                "Imperial",
                "Nord",
                "Redguard",
                "DarkElf",
                "HighElf",
                "WoodElf"
            ]
        }
    },
    "type": "object",
    "properties": {
        "RCS": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "race"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The name of the config entry",
                        "pattern": "^[^<>:\"/\\\\|?*]{1,255}$"
                    },
                    "race": {
                        "$ref": "#/$defs/race"
                    },
                    "vampireRace": {
                        "$ref": "#/$defs/race"
                    },
                    "headPart": {
                        "description": "The head part preset(s) for injecting race into FormID lists",
                        "oneOf": [
                            {
                                "$ref": "#/$defs/headPartType"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/headPartType"
                                }
                            }
                        ]
                    }
                }
            }
        },
        "AlternateForms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/form"
            },
            "description": "Additional alternate-form races whose original race is retained for restoration. Werewolf, vampire lord and werebear races are included by default. Lists from separate files are merged."
        }
    },
    "oneOf": [
        {
            "required": [
                "RCS"
            ]
        },
        {
            "required": [
                "AlternateForms"
            ]
        }
    ]
}