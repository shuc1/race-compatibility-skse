{
    "$schema": "https://raw.githubusercontent.com/shuc1/race-compatibility-skse/main/res/schema/schema-config",
    "RCS": {
        "alternateForms": [
            "MyWerewolfMod.esp|0x800"
        ],
        "getRaceExclusions": [
            {
                "functions": [
                    {
                        "script": "MyScript",
                        "function": "MyFunction1"
                    },
                    {
                        "script": "MyScript",
                        "function": "MyFunction2",
                        "state": "MyState"
                    }
                ]
            },
            {
                "functions": [
                    {
                        "script": "MyVampireVariantTransformationScript",
                        "function": "TransformToVampireVariant"
                    },
                    {
                        "script": "MyVampireVariantTransformationScript",
                        "function": "TransformBack"
                    }
                ],
                "unlessProxyMatches": [
                    "NordRaceVampireVariant",
                    "KhajiitRaceVampireVariant"
                ]
            }
        ]
    }
}